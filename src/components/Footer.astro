---
// src/components/Footer.astro
const today = new Date();
---

<footer class="mt-auto border-t border-slate-200 bg-white py-8 text-slate-600">
  <div class="max-w-4xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm">
    <p>&copy; {today.getFullYear()} Peaceful Planet. All rights reserved.</p>
    
    <div class="flex gap-4">
      <a href="/about" class="hover:text-emerald-600 transition">About</a>
      <a href="/rss.xml" class="hover:text-emerald-600 transition">RSS Feed</a>
    </div>
  </div>
</footer>
