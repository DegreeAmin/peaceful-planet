---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home | Peaceful Planet">
  <section class="py-12 text-center border-b border-slate-200 mb-10">
    <h1 class="text-4xl font-extrabold text-slate-900 sm:text-5xl tracking-tight">
      Simple steps for a peaceful life & planet.
    </h1>
    <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
      Articles, guides, and practical steps on sustainability, mindfulness, and slow living.
    </p>
  </section>

  <section>
    <h2 class="text-2xl font-bold mb-6">Latest Articles</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {posts.map((post) => (
        <a 
		  href={`/blog/${post.id.replace(/\.mdx?$/, '')}`}
          class="block p-6 bg-white border border-slate-200 rounded-xl hover:border-emerald-500 transition shadow-sm"
        >
          <FormattedDate date={post.data.pubDate} />
          <h3 class="text-xl font-semibold mt-2 text-slate-800">{post.data.title}</h3>
          <p class="mt-2 text-slate-600 text-sm">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>