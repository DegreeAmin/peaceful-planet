---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us | Peaceful Planet" description="Mengenai misi Peaceful Planet.">
  <section class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-extrabold text-slate-900 mb-4">Mengenai Peaceful Planet</h1>
    <p class="text-slate-600 text-lg leading-relaxed mb-4">
      Peaceful Planet ialah pusat perkongsian maklumat dan panduan amalan gaya hidup mampan, kesedaran alam sekitar, dan kesejahteraan harian.
    </p>
    <p class="text-slate-600 text-lg leading-relaxed">
      Matlamat kami adalah untuk memberikan maklumat yang praktikal dan mudah difahami untuk semua lapisan masyarakat.
    </p>
  </section>
</BaseLayout>